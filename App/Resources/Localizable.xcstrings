      "comment": "%@ = technical error message"
    },
    "The helper is installed but did not answer. Reinstalling usually fixes this.": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Помощник установлен, но не ответил. Обычно помогает переустановка."
          }
        }
