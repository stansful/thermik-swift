      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите точку, чтобы изменить её; дважды щёлкните, чтобы добавить новую; нажмите Delete, чтобы удалить выбранную. Стрелки сдвигают точку (с ⌥ — крупнее)."
